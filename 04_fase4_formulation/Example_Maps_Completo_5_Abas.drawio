        <mxCell id="ex_2_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" value="&lt;b&gt;Exemplo 2.1: Continuidade acima do limiar&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; em navegação e Limiar de Retorno Seguro = 25%&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; bateria cai para 40%&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; mantém execução normal da missão" vertex="1">
          <mxGeometry height="125" width="340" x="480" y="290" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e1" edge="1" parent="1" source="rule_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" target="ex_2_1">
