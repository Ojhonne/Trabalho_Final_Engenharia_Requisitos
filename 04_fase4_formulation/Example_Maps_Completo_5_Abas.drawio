        <mxCell id="edge_f_r1" edge="1" parent="1" source="feat_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" target="rule_1">
          <mxGeometry relative="1" as="geometry" />
