  <diagram id="em2" name="EM 2 - Acessibilidade">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="feat_1" value="Funcionalidade 2:&#xa;Verificação de Acessibilidade do Alvo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="rule_1" value="Regra 1:&#xa;Verificar acessibilidade antes da coleta e tentar posição alternativa se houver obstáculo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_1" value="&lt;b&gt;Exemplo 1.1: Acesso livre sem obstáculos&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; robô no perímetro do Alvo 1 sem obstáculos&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; executa verificação de acessibilidade&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; valida acesso livre e inicia coleta de dados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_1" target="ex_1_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_2" value="&lt;b&gt;Exemplo 1.2: Desvio para posição alternativa&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; pedra bloqueia acesso direto ao Alvo 2&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; executa verificação de acessibilidade&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; identifica bloqueio e desvia para Posição Alternativa 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_1_1" target="ex_1_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rule_2" value="Regra 2:&#xa;Marcar alvo como &#39;inacessível&#39; no log se nenhuma posição alternativa for viável" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_1" value="&lt;b&gt;Exemplo 2.1: Coleta via posição alternativa viável&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; Alvo 3 e Pos. Alt. 1 obstruídos; Pos. Alt. 2 livre&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; verifica viabilidade da Pos. Alt. 2&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; desloca-se e coleta sem marcar como inacessível" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_2" target="ex_2_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_2" value="&lt;b&gt;Exemplo 2.2: Registro de alvo inacessível&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; vala bloqueia Alvo 3 e todas as posições alternativas&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; conclui verificação sem rota livre&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; marca Alvo 3 como &#39;inacessível&#39; no Log e vai ao Alvo 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="445" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_2_1" target="ex_2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="question_1" value="&lt;b&gt;Dúvida / Suposição [Dom2]:&lt;/b&gt;&lt;br/&gt;Quantas posições alternativas no máximo são avaliadas dentro do raio aceitável antes de declarar inacessibilidade?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
