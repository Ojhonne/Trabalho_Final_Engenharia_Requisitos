        <mxCell id="edge_r2_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_2_1" target="ex_2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="question_1" value="&lt;b&gt;Dúvida / Suposição [Dom6]:&lt;/b&gt;&lt;br/&gt;O operador pode configurar limiares distintos de qualidade para sensores visuais e químicos na mesma missão?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
