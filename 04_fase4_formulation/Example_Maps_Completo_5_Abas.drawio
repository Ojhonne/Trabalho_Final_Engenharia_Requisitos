  <diagram id="em4" name="EM 4 - Priorização">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="feat_1" value="Funcionalidade 4:&#xa;Priorização de Alvos e Conclusão da Missão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="rule_1" value="Regra 1:&#xa;Visitar alvos opcionais somente após concluir todos os obrigatórios, havendo tempo e energia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_1" value="&lt;b&gt;Exemplo 1.1: Transição para opcionais&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; 5 Obrigatórios concluídos; 45% bateria e 25 min livres&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; verifica recursos para Opcionais (15% bat., 10 min)&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; emite Sinal de Transição de Fase e vai ao Opcional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_1" target="ex_1_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_2" value="&lt;b&gt;Exemplo 1.2: Retorno sem visitar opcionais&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; 5 Obrigatórios concluídos; Opcional exige 20% bateria&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; identifica apenas 8% acima do Limiar Seguro&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; ignora Alvos Opcionais e retorna à Base de Recarga" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_1_1" target="ex_1_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rule_2" value="Regra 2:&#xa;Concluir missão e notificar Controlador quando todos os obrigatórios tiverem resultado explícito" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_1" value="&lt;b&gt;Exemplo 2.1: Missão ainda em andamento&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; lista com 4 Obrigatórios e apenas 3 processados&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; finaliza registro do 3º Alvo Obrigatório&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; mantém status &#39;em andamento&#39; e segue ao 4º" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_2" target="ex_2_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_2" value="&lt;b&gt;Exemplo 2.2: Conclusão oficial da missão&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; 3 Obrigatórios concluídos + 1 &#39;inacessível&#39;&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; último Obrigatório recebe resultado explícito&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; registra status &#39;concluída&#39; e notifica Controlador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="445" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_2_1" target="ex_2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="question_1" value="&lt;b&gt;Dúvida / Suposição [Dom11]:&lt;/b&gt;&lt;br/&gt;Caso haja tempo/energia para apenas um subconjunto dos Alvos Opcionais, eles seguem a ordem cadastrada?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
