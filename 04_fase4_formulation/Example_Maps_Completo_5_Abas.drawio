  <diagram id="em3" name="EM 3 - Qualidade">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="feat_1" value="Funcionalidade 3:&#xa;Controle de Qualidade da Amostragem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="rule_1" value="Regra 1:&#xa;Avaliar qualidade segundo critérios configuráveis e fazer até 2 re-tentativas de ajuste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_1" value="&lt;b&gt;Exemplo 1.1: Validação na 1ª tentativa&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; amostra no Alvo 1 com nitidez 92% (mín. 85%)&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; avalia qualidade da amostra&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; valida coleta e associa metadados ao Alvo 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_1" target="ex_1_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_2" value="&lt;b&gt;Exemplo 1.2: Sucesso na 1ª re-tentativa&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; 1ª coleta no Alvo 2 teve nitidez 68% (&lt; 85%)&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; ajusta sensor/posição e recoleta com 89%&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; valida coleta e registra dados no Log da Missão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_1_1" target="ex_1_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rule_2" value="Regra 2:&#xa;Registrar &#39;realizada com qualidade insuficiente&#39; após esgotar as 2 re-tentativas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_1" value="&lt;b&gt;Exemplo 2.1: Sucesso na 2ª re-tentativa&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; 1ª re-tentativa no Alvo 4 teve 72% (&lt; 85%)&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; reposiciona ângulo na 2ª re-tentativa e atinge 86%&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; valida amostragem e avança para o Alvo 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_2" target="ex_2_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_2" value="&lt;b&gt;Exemplo 2.2: Falha após 2 re-tentativas&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; coleta inicial + 2 re-tentativas &lt; 85% no Alvo 4&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; conclui avaliação da última tentativa&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; registra &#39;realizada com qualidade insuficiente&#39; e vai ao Alvo 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
