        <mxCell id="ex_1_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" value="&lt;b&gt;Exemplo 1.1: Início autorizado&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; consumo estimado = 60% e bateria atual = 85%&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; Controlador solicita início&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; autoriza e inicia navegação ao 1º alvo obrigatório" vertex="1">
          <mxGeometry height="125" width="340" x="60" y="290" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e1" edge="1" parent="1" source="rule_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" target="ex_1_1">
          <mxGeometry relative="1" as="geometry" />
