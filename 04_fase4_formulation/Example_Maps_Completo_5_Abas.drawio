  <diagram id="em5" name="EM 5 - Intervenção">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="feat_1" value="Funcionalidade 5:&#xa;Intervenção Humana e Retomada Pós-Recarga" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="rule_1" value="Regra 1:&#xa;Permitir que o Controlador da Missão pause ou aborte a operação a qualquer momento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_1" value="&lt;b&gt;Exemplo 1.1: Pausa por intervenção humana&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; robô navegando autonomamente ao Alvo 2&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; Controlador envia comando &#39;Pausar Missão&#39;&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; para deslocamento e registra &#39;pausada por intervenção&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_1" target="ex_1_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_1_2" value="&lt;b&gt;Exemplo 1.2: Aborto e retorno seguro à base&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; robô coletando dados no Alvo 3&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; Controlador envia comando &#39;Abortar Missão&#39;&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; cancela coleta/lista restante e retorna à base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r1_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_1_1" target="ex_1_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rule_2" value="Regra 2:&#xa;Retomar missão pós-recarga no checkpoint salvo somente após autorização humana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="165" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="feat_1" target="rule_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_1" value="&lt;b&gt;Exemplo 2.1: Espera por autorização pós-recarga&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; robô na base com Checkpoint salvo no Alvo 3&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; Base envia sinal de recarga concluída (100%)&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; aguarda acoplado e notifica prontidão para retomada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="290" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="rule_2" target="ex_2_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_2_2" value="&lt;b&gt;Exemplo 2.2: Retomada sem duplicar coletas&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Dado que:&lt;/i&gt; recarregado (100%), Alvos 1-2 feitos, Alvo 3 pendente&lt;br/&gt;• &lt;i&gt;Quando:&lt;/i&gt; Controlador envia autorização de retomada&lt;br/&gt;• &lt;i&gt;Então:&lt;/i&gt; navega direto ao Alvo 3 sem repetir Alvos 1 e 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="445" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge_r2_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" edge="1" parent="1" source="ex_2_1" target="ex_2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="question_1" value="&lt;b&gt;Dúvida / Suposição [Dom9, Dom10]:&lt;/b&gt;&lt;br/&gt;O Checkpoint de Missão persiste em memória não volátil caso ocorra reinicialização durante a recarga?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="165" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=none;" edge="1" parent="1" source="feat_1" target="question_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="leg_title" value="Legenda (Example Mapping):" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="880" y="330" width="240" height="25" as="geometry" />
