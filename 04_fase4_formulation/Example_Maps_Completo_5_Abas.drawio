          <mxGeometry height="80" width="340" x="480" y="165" as="geometry" />
        </mxCell>
        <mxCell id="edge_f_r2" edge="1" parent="1" source="feat_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.5;endArrow=none;" target="rule_2">
