        <mxCell id="1" parent="0" />
        <mxCell id="f-N39QWTLXMj29YHLSzI-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;labelBackgroundColor=none;" value="&lt;b&gt;Cenário To-Be 1: Monitoramento Autônomo Completo dos Cultivos&lt;/b&gt;&lt;br&gt;&lt;b&gt;Objetivo:&lt;/b&gt; Demonstrar a operação bem-sucedida e integrada entre Drone, Controlador e Robô Autônomo.&lt;br&gt;&lt;b&gt;Contexto:&lt;/b&gt; A lista de alvos (obrigatórios e opcionais) foi cadastrada e o robô está posicionado na estação de recarga com bateria em 100%.&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Passos:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="1040" x="30" y="10" as="geometry" />
        </mxCell>
        <mxCell id="ORAq72lCWR8AVSSV5Rip-1" parent="1" style="text;whiteSpace=wrap;fontSize=12;labelBackgroundColor=none;" value="1. O Drone sobrevoa a área agrícola e transmite as informações sobre a topologia do terreno ao Sistema de Controle do Robô.&#xa;2. O Controlador da Missão envia a lista de alvos georreferenciados e autoriza o início da missão.&#xa;3. O Sistema de Controle do Robô lê o nível de carga da bateria e inicia a navegação autônoma em direção ao primeiro Alvo Obrigatório.&#xa;4. Os Sensores transmitem os dados de amostragem ao Sistema de Controle.&#xa;5. O Sistema de Controle valida a amostragem e registra o status no Log da Missão.&#xa;6.  O Sistema de Controle do Robô notifica a conclusão da missão ao Controlador de Missão&#xa;" vertex="1">
          <mxGeometry height="120" width="800" x="50" y="80" as="geometry" />
        </mxCell>
        <mxCell id="z-TsbUPT2q0QQuvzKbaH-1" parent="1" style="text;whiteSpace=wrap;html=1;fontColor=#FEFAE0;" value="&lt;b style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Resultado:&lt;/b&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt; 100% dos alvos obrigatórios e opcionais viáveis são inspecionados com amostragem armazenada e log atualizado.&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="740" x="40" y="190" as="geometry" />
        </mxCell>
